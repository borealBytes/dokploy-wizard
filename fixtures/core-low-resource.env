STACK_NAME=core-low-stack
ROOT_DOMAIN=example.com
DOKPLOY_BOOTSTRAP_MOCK_API_KEY=dokp-test-key
ENABLE_HEADSCALE=true
HOST_OS_ID=ubuntu
HOST_OS_VERSION_ID=24.04
HOST_CPU_COUNT=2
HOST_MEMORY_GB=4
HOST_DISK_GB=40
# Pin the data-root like every other host fact here; otherwise the fixture inherits
# the developer machine's Docker data-root (often a second drive) and the contract
# test fails for environment reasons.
HOST_DISK_PATH=/var/lib/docker
HOST_DOCKER_INSTALLED=true
HOST_DOCKER_DAEMON_REACHABLE=true
HOST_PORT_80_IN_USE=false
HOST_PORT_443_IN_USE=false
HOST_PORT_3000_IN_USE=false
HOST_ENVIRONMENT=local
DOKPLOY_BOOTSTRAP_HEALTHY=false
