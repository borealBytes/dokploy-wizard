@@ -0,0 +1,61 @@
+import { describe, expect, it } from "vitest";
+import type { Model } from "@/components/model-selector";
+import {
+  isValidCentralModel,
+  normalizeModelSelection,
+} from "@/lib/use-models";
+
+const hash = "a".repeat(64);
+const centralModel: Model = {
+  id: "opencode-go/anthropic/claude-sonnet-4.5",
+  label: "Claude Sonnet 4.5",
+  provider: "Anthropic",
+  tier: "high",
+  context_length: 200_000,
+  max_completion_tokens: 16_000,
+  pricing: {
+    prompt: 3,
+    completion: 15,
+    input_cache_read: 0.3,
+    input_cache_write: 3.75,
+  },
+  modality: "text->text",
+  description: "Central model",
+  provenance: {
+    managed_by: "dokploy-wizard",
+    managed_catalog: "opencode-go",
+    source_id: "anthropic/claude-sonnet-4.5",
+    merged_decision_sha256: hash,
+    dokploy_pricing_selection_sha256: hash,
+  },
+};
+
+describe("central-only model selection", () => {
+  it("accepts only priced opencode-go models with matching provenance", () => {
+    expect(isValidCentralModel(centralModel)).toBe(true);
+    expect(
+      isValidCentralModel({
+        ...centralModel,
+        pricing: { ...centralModel.pricing, completion: 0 },
+      }),
+    ).toBe(false);
+    expect(
+      isValidCentralModel({
+        ...centralModel,
+        max_completion_tokens: 0,
+      }),
+    ).toBe(false);
+    expect(
+      isValidCentralModel({
+        ...centralModel,
+        provenance: { ...centralModel.provenance, source_id: "other/model" },
+      }),
+    ).toBe(false);
+  });
+
+  it("normalizes stale selections to the first valid catalogue model", () => {
+    const stale = { ...centralModel, id: "openrouter/legacy/model" };
+    expect(normalizeModelSelection(stale, [centralModel])).toBe(centralModel);
+    expect(normalizeModelSelection(centralModel, [])).toBeNull();
+  });
+});
