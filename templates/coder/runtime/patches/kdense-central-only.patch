+
+const SHA256_RE = /^[a-f0-9]{64}$/;
+
+export function isValidCentralModel(model: Model): boolean {
+  const sourceId = model.id.startsWith("opencode-go/")
+    ? model.id.slice("opencode-go/".length)
+    : "";
+  const cacheRead = model.pricing.input_cache_read;
+  const cacheWrite = model.pricing.input_cache_write;
+  const provenance = model.provenance;
+  return (
+    Boolean(sourceId) &&
+    Number.isFinite(model.pricing.prompt) &&
+    model.pricing.prompt > 0 &&
+    Number.isFinite(model.pricing.completion) &&
+    model.pricing.completion > 0 &&
+    typeof cacheRead === "number" &&
+    Number.isFinite(cacheRead) &&
+    cacheRead >= 0 &&
+    typeof cacheWrite === "number" &&
+    Number.isFinite(cacheWrite) &&
+    cacheWrite >= 0 &&
+    Number.isFinite(model.context_length) &&
+    model.context_length > 0 &&
+    typeof model.max_completion_tokens === "number" &&
+    Number.isFinite(model.max_completion_tokens) &&
+    model.max_completion_tokens > 0 &&
+    provenance?.managed_by === "dokploy-wizard" &&
+    provenance.managed_catalog === "opencode-go" &&
+    provenance.source_id === sourceId &&
+    typeof provenance.merged_decision_sha256 === "string" &&
+    SHA256_RE.test(provenance.merged_decision_sha256) &&
+    typeof provenance.dokploy_pricing_selection_sha256 === "string" &&
+    SHA256_RE.test(provenance.dokploy_pricing_selection_sha256)
+  );
+}
+
+export function normalizeModelSelection(selected: Model, models: Model[]): Model | null {
+  return models.find((model) => model.id === selected.id) ?? models[0] ?? null;
 }
 
