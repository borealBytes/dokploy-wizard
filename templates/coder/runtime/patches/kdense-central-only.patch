new file mode 100644
index 0000000..0cc622b
--- /dev/null
+++ b/server/test/credentials-central.test.ts
@@ -0,0 +1,50 @@
+import fs from "node:fs";
+import path from "node:path";
+import Fastify from "fastify";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { registerCredentialRoutes } from "../src/api/credentials.ts";
+import { REPO_ROOT } from "../src/config.ts";
+
+const envPath = path.join(REPO_ROOT, ".env");
+let originalEnv: Buffer | null;
+
+beforeEach(() => {
+  originalEnv = fs.existsSync(envPath) ? fs.readFileSync(envPath) : null;
+  fs.writeFileSync(envPath, "CENTRAL_SENTINEL=keep\n", "utf-8");
+  process.env.KDENSE_WIZARD_CENTRAL_ONLY = "1";
+  process.env.OPENROUTER_API_KEY = "existing-public-key";
+});
+
+afterEach(() => {
+  if (originalEnv === null) fs.rmSync(envPath, { force: true });
+  else fs.writeFileSync(envPath, originalEnv);
+  delete process.env.KDENSE_WIZARD_CENTRAL_ONLY;
+  delete process.env.OPENROUTER_API_KEY;
+  vi.unstubAllGlobals();
+});
+
+describe("central-only credential mutation policy", () => {
+  it("rejects create, update, delete, and test paths before file or upstream mutation", async () => {
+    const fetchMock = vi.fn();
+    vi.stubGlobal("fetch", fetchMock);
+    const app = Fastify();
+    await registerCredentialRoutes(app);
+    const before = fs.readFileSync(envPath);
+
+    for (const request of [
+      { method: "PUT", url: "/credentials", payload: { openrouterApiKey: "replacement-key" } },
+      { method: "POST", url: "/credentials", payload: { openrouterApiKey: "new-key-value" } },
+      { method: "DELETE", url: "/credentials", payload: { provider: "openrouter" } },
+      { method: "POST", url: "/credentials/test", payload: { provider: "openrouter" } },
+    ] as const) {
+      const response = await app.inject(request);
+      expect(response.statusCode).toBe(403);
+      expect(response.json().detail).toMatch(/disabled in central-only mode/i);
+    }
+
+    expect(fs.readFileSync(envPath)).toEqual(before);
+    expect(process.env.OPENROUTER_API_KEY).toBe("existing-public-key");
+    expect(fetchMock).not.toHaveBeenCalled();
+    await app.close();
+  });
+});
