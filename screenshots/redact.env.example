# dokploy-wizard screenshot studio — redaction config (template).
#
# Copy to redact.env (gitignored — it carries the operator's real identity)
# and fill the values from YOUR box. Anything listed here is blurred
# character-precisely wherever it renders; the subdomain labels of
# REDACT_ROOT_DOMAIN stay visible so the screenshots read honestly.

# Root domain of the box (ROOT_DOMAIN in your install env).
REDACT_ROOT_DOMAIN=example.com

# Operator login name (the Coder username of the deployer) and their real
# email (DOKPLOY_ADMIN_EMAIL).
REDACT_LOGIN=dev
REDACT_EMAIL=dev@example.com

# Extra identity strings: org handles, tailnet peer labels that appear in
# URLs (the local-model host and its tailnet domain), the box's public IP.
REDACT_ORG=example-org
REDACT_TAILNET_LABELS=tuxbox,home-net.ts.net
REDACT_BOX_IP=203.0.113.10

# Never blur these even if they match a pattern above (the provisioner is
# part of the story the screenshots tell). Comma-separated.
REDACT_KEEP=dokploy-wizard,wizard-provisioner
