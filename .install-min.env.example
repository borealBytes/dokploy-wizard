# Dokploy Wizard minimal install env example
# Copy this file to .install-min.env, fill in operator-owned values, then chmod 0600 .install-min.env.
# Keep .install-min.env private and uncommitted. Never commit real passwords, tokens, or API keys.
#
# All things < > need to be updated, and you do not keep the < > in your final value
# for the env variable. Leave everything else alone.

## VPS Connection
# VPS_HOST - IP Address from Contaboo for your VPS
# VPS_ROOT_PASSWORD - Root password you set for your Contaboo VPS
VPS_HOST=<contaboo-vps-ip-address>
VPS_ROOT_PASSWORD=<contaboo-vps-root-password>

## Core stack identity
# Fill in ROOT_DOMAIN with your target domain you purchased on Cloudflare, e.g. example.com.
# STACK_NAME defaults from ROOT_DOMAIN (example.com -> example-com).
# Uncomment only if you need a different stack name.
# STACK_NAME=<your-stack-name>
ROOT_DOMAIN=<example.com>
TZ=America/New_York
PACKS=seaweedfs,coder

## Cloudflare operator credentials
# Cloudflare Account ID + Zone ID: in the Cloudflare dashboard, open Account home, then click the
#    domain you purchased, scroll to the bottom on the right, and copy the Account ID and Zone ID.
# Cloudflare API token (https://dash.cloudflare.com/profile/api-tokens): create an API token, not a
#    Global API Key. Scope it only to this account and zone.
#    Minimum token permissions for the wizard:
#    - Zone: DNS Edit, so the wizard can create and update tunnel DNS records.
#    - Account: Cloudflare One Connectors:Edit, Cloudflare One Connector: cloudflared:Edit,
#      Cloudflare Tunnel:Edit.
#    - Access: Apps and Policies:Edit only when Cloudflare Access OTP apps are enabled.
# Do not use a Cloudflare Global API Key. Do not grant all accounts or all zones unless this is a
#    disposable test account.
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_ZONE_ID=<cloudflare-zone-id>
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>

## Dokploy bootstrap
# Set your own email and password so you can log in to your Dokploy workspace and apps.
# DOKPLOY_SUBDOMAIN defaults to dokploy. Uncomment only to override.
# DOKPLOY_SUBDOMAIN=dokploy
DOKPLOY_ADMIN_EMAIL=<operator@example.com>
DOKPLOY_ADMIN_PASSWORD=<strong-dokploy-admin-password>

## Default AI provider across workspace apps (through LiteLLM)
# Upstream provider keys terminate at LiteLLM. App packs receive wizard-managed virtual keys.
# The model autosync sidecar registers new provider models automatically after install.
AI_DEFAULT_PROVIDER=opencode-go
AI_DEFAULT_MODEL=deepseek-v4-flash

## OpenCode Go upstream provider (https://opencode.ai/go)
# Set your 'LITELLM_OPENCODE_GO_API_KEY' to use OpenCode Go's API. Whenever this key is set,
# the autosync sidecar registers OpenCode Go's entire live catalog - no model list needed.
LITELLM_OPENCODE_GO_API_KEY=<opencode-go-api-key>

## OpenRouter upstream provider (https://openrouter.ai/)
# Set your 'LITELLM_OPENROUTER_API_KEY'. The autosync sidecar already registers the top 20
# weekly leaderboard models plus the top 10 free models as sync/openrouter/*, so no manual
# model list is needed.
# Uncomment LITELLM_OPENROUTER_MODELS only to layer manual aliases beyond the synced set.
# LITELLM_OPENROUTER_MODELS=deepseek/deepseek-v4-flash:free,google/gemma-4-31b-it:free
LITELLM_OPENROUTER_API_KEY=<openrouter-api-key>

## NVIDIA upstream provider (https://build.nvidia.com/explore/discover)
# Set your 'LITELLM_NVIDIA_API_KEY'. The API key and base URL are all NVIDIA needs: the
# autosync sidecar keeps the free, chat-verified NVIDIA endpoints (default cap 20) current
# on its own, and if AI_DEFAULT_PROVIDER=nvidia the AI default model is pinned into the
# gateway config automatically - no manual model list required.
# LITELLM_NVIDIA_MODELS is optional: manual aliases layered on top of the synced set.
LITELLM_NVIDIA_API_KEY=<nvidia-api-key>
LITELLM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LITELLM_NVIDIA_MODELS=moonshotai/kimi-k2.6,deepseek-ai/deepseek-v4-flash

## Optional Docker Hub auth
# Uncomment both only if unauthenticated Docker Hub pulls hit rate limits during install/proof.
# DOCKER_USERNAME=<docker-hub-username>
# DOCKER_PAT=<docker-hub-personal-access-token>

## Optional local LLM upstream (vLLM/Ollama reachable over the network)
# Uncomment to expose a self-hosted model through LiteLLM alongside the cloud providers.
# LITELLM_LOCAL_BASE_URL=http://<host-on-your-network>:<port>/v1
# LITELLM_LOCAL_MODEL=<served-model-name>
# LITELLM_LOCAL_API_KEY=<local-api-key-or-sk-no-key-required>

## Optional Tailscale private host access
# Uncomment to add the VPS to your tailnet for private host access.
# Create an auth key at https://login.tailscale.com/admin/settings/keys.
# ENABLE_HEADSCALE=false
# ENABLE_TAILSCALE=true
# TAILSCALE_AUTH_KEY=<tailscale-auth-key>
# TAILSCALE_HOSTNAME=<tailnet-hostname>
